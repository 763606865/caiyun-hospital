APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# 商业授权（生产环境开启后，所有 Web/API 请求均会校验许可证）
LICENSE_ENABLED=false
LICENSE_GLOBAL_MIDDLEWARE=false
LICENSE_TOKEN=
LICENSE_PUBLIC_KEY_PATH=storage/app/license/public.pem
# LICENSE_PUBLIC_KEY=Base64EncodedPem
LICENSE_VERIFY_DOMAIN=true
LICENSE_LEEWAY=300
LICENSE_REMOTE_ENABLED=false
LICENSE_REMOTE_ENDPOINT=https://license.example.com/api/v1/leases
LICENSE_PROJECT=cms
LICENSE_REMOTE_TIMEOUT=5
LICENSE_REMOTE_RETRIES=1
LICENSE_REMOTE_CHECK_INTERVAL=60
LICENSE_OFFLINE_GRACE_HOURS=72
# LICENSE_INSTANCE_ID=

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=
CLIENT_VERSION_CACHE_TTL=300

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SMS_DRIVER=log
SMS_VERIFICATION_CODE_TEMPLATE=verification_code
# SMS_LOG_CHANNEL=

# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_REGION=ap-guangzhou

# 微信小程序登录及手机号授权
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_APP_SECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 是否将每次 API 请求写入 api_request_logs（高流量环境建议关闭）
API_REQUEST_LOG_ENABLED=false

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_DEFAULT_REGION=
OSS_BUCKET=
OSS_ENDPOINT=

# API 文件上传
UPLOAD_DISK=oss
UPLOAD_MAX_SIZE=20480

LICENSE_OPENAPI_CLIENT_ID=opk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LICENSE_OPENAPI_CLIENT_SECRET=<secret-issued-by-license-server>
